# Vertex AI Configuration
# Copy this to .env.local and configure your credentials

# ── Utility / persona-generation model (Gemma) ──────────────────────────────
# PREFERRED: Cloudflare AI Gateway -> Vertex AI (Gemma MaaS). This is the path
# PIPE's workers use. The Gateway holds the GCP service account and refreshes
# OAuth itself, so the app only needs a Cloudflare API token. No JWT/gcloud.
CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-name>/google-vertex-ai
CF_API_TOKEN=cfut_xxx_cloudflare_ai_gateway_token
VERTEX_AI_MODEL=google/gemma-4-26b-a4b-it-maas

# ── Embeddings (direct Vertex) ──────────────────────────────────────────────

# Option 1: Service Account Key (recommended for development)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=textembedding-gecko@001

# Option 2: API Key (simpler, but less secure)
# VERTEX_API_KEY=your-vertex-api-key
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=textembedding-gecko@001

# Option 3: Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# No additional configuration needed in .env.local