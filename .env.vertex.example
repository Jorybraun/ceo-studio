# Vertex AI Configuration for Embeddings
# Copy this to .env.local and configure your Google Cloud credentials

# Option 1: Service Account Key (recommended for development)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=textembedding-gecko@001

# Option 2: API Key (simpler, but less secure)
# VERTEX_API_KEY=your-vertex-api-key
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=textembedding-gecko@001

# Option 3: Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# No additional configuration needed in .env.local