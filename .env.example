# CEO Studio Configuration Example
# Copy this to .env.local and configure your credentials

# ============================================
# Main LLM Provider (for Document Agent)
# ============================================
# Options: openai, anthropic, null (offline)
CEO_MODEL_PROVIDER=openai
CEO_MODEL=gpt-4o
OPENAI_API_KEY=your-openai-api-key-here

# For Anthropic:
# CEO_MODEL_PROVIDER=anthropic
# CEO_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# For offline mode (no LLM):
# CEO_MODEL_PROVIDER=null

# ============================================
# Voice Agent (ElevenLabs)
# ============================================
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # "Sarah" voice
CEO_CONVAI_LLM=gemini-2.0-flash
CEO_CONVAI_MODE=intake     # intake = cheap voice capture + tool/handoff, not long planning
CEO_CONVAI_MAX_TOKENS=220  # Max tokens per response (default: 220)
CEO_CONVAI_MAX_MINUTES=2   # Max session duration in minutes (default: 2)

# ============================================
# Vertex AI for Embeddings
# ============================================
# Option 1: API Key (simpler)
VERTEX_API_KEY=your-vertex-api-key
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=textembedding-gecko@001

# Option 2: Service Account Key (recommended for development)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=textembedding-gecko@001

# ============================================
# Optional: Cost Control
# ============================================
# CEO_ALLOW_PAID=1  # Allow paid providers for automated dispatch (default: 0)
