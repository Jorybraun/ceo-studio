#!/usr/bin/env python3
"""
Minimal web UI for a domain-room.

Usage:
    ./bin/domain-room-ui discovery

This starts a local web server (default port 8765) with a simple browser-based chat.
It reads/writes the same chat.log that the tmux room uses, so tmux agents and the web UI stay in sync.

No external dependencies. Pure stdlib.
"""

import json
import os
import sys
import time
from datetime import datetime
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs

DEFAULT_PORT = 8765

def get_room_paths(domain):
    base = os.path.join(os.path.dirname(__file__), "..", "brain", "rooms", domain)
    os.makedirs(base, exist_ok=True)
    chat_log = os.path.join(base, "chat.log")
    if not os.path.exists(chat_log):
        with open(chat_log, "w") as f:
            f.write(f"# {domain} Team Room - Chat Log\nRoom created: {datetime.utcnow().isoformat()}Z\n\n")
    return chat_log

def read_recent_messages(chat_log, limit=100):
    if not os.path.exists(chat_log):
        return []
    with open(chat_log, "r", encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    messages = []
    for line in lines[-limit:]:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        messages.append(line)
    return messages

def append_message(chat_log, speaker, message):
    ts = datetime.utcnow().isoformat() + "Z"
    line = f"[{ts}] {speaker}: {message}"
    with open(chat_log, "a", encoding="utf-8") as f:
        f.write(line + "\n")
    return line

class RoomHandler(BaseHTTPRequestHandler):
    def __init__(self, *args, chat_log=None, domain=None, **kwargs):
        self.chat_log = chat_log
        self.domain = domain
        super().__init__(*args, **kwargs)

    def do_GET(self):
        if self.path == "/" or self.path == "/index.html":
            self._serve_chat_page()
        elif self.path == "/messages":
            self._serve_messages()
        else:
            self.send_error(404)

    def do_POST(self):
        if self.path == "/post":
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length).decode("utf-8")
            data = parse_qs(body)
            speaker = data.get("speaker", ["Human"])[0]
            message = data.get("message", [""])[0].strip()

            if message:
                line = append_message(self.chat_log, speaker, message)
                self._send_json({"ok": True, "line": line})
            else:
                self._send_json({"ok": False, "error": "Empty message"})
        else:
            self.send_error(404)

    def _serve_chat_page(self):
        html = f"""<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>{self.domain} Team Room</title>
<style>
body {{ font-family: system-ui, sans-serif; margin: 20px; background: #111; color: #eee; }}
#chat {{ height: 70vh; overflow-y: auto; border: 1px solid #333; padding: 10px; background: #1a1a1a; white-space: pre-wrap; }}
#input-area {{ margin-top: 10px; display: flex; gap: 8px; }}
input, button {{ font-size: 16px; padding: 8px; }}
#speaker {{ width: 160px; }}
#message {{ flex: 1; }}
button {{ cursor: pointer; }}
.log-line {{ margin-bottom: 4px; }}
</style>
</head>
<body>
<h1>{self.domain} Team Room</h1>
<p style="color:#888">Shared with tmux agents. Messages appear here and in the terminal room.</p>
<div id="chat"></div>
<div id="input-area">
  <input id="speaker" value="Human" placeholder="Your name">
  <input id="message" placeholder="Type your message..." onkeypress="if(event.key==='Enter') postMessage()">
  <button onclick="postMessage()">Send</button>
</div>
<script>
let lastLength = 0;

async function fetchMessages() {{
  const res = await fetch('/messages');
  const data = await res.json();
  const chat = document.getElementById('chat');
  chat.innerHTML = '';
  data.messages.forEach(line => {{
    const div = document.createElement('div');
    div.className = 'log-line';
    div.textContent = line;
    chat.appendChild(div);
  }});
  chat.scrollTop = chat.scrollHeight;
}}

async function postMessage() {{
  const speaker = document.getElementById('speaker').value || 'Human';
  const message = document.getElementById('message').value.trim();
  if (!message) return;
  await fetch('/post', {{
    method: 'POST',
    headers: {{ 'Content-Type': 'application/x-www-form-urlencoded' }},
    body: `speaker=${{encodeURIComponent(speaker)}}&message=${{encodeURIComponent(message)}}`
  }});
  document.getElementById('message').value = '';
  await fetchMessages();
}}

setInterval(fetchMessages, 1500);
fetchMessages();
</script>
</body>
</html>"""
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(html.encode("utf-8"))

    def _serve_messages(self):
        messages = read_recent_messages(self.chat_log)
        self._send_json({"messages": messages})

    def _send_json(self, obj):
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(obj).encode("utf-8"))

    def log_message(self, format, *args):
        # Quiet logging
        pass

def run_server(domain, port=DEFAULT_PORT):
    chat_log = get_room_paths(domain)
    print(f"Starting web UI for domain '{domain}'")
    print(f"Chat log: {chat_log}")
    print(f"Open in browser: http://localhost:{port}")
    print("Press Ctrl-C to stop.")

    def handler(*args, **kwargs):
        RoomHandler(*args, chat_log=chat_log, domain=domain, **kwargs)

    server = HTTPServer(("", port), handler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: domain-room-ui <domain-slug> [port]")
        sys.exit(1)
    domain = sys.argv[1]
    port = int(sys.argv[2]) if len(sys.argv) > 2 else DEFAULT_PORT
    run_server(domain, port)
