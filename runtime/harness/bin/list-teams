#!/usr/bin/env python3
"""Simple tool to list teams defined under harness/teams/ (symmetric to list-personas)."""

import sys
from pathlib import Path

HARNESS_ROOT = Path(__file__).parent.parent
TEAMS_ROOT = HARNESS_ROOT / "teams"


def main():
    if not TEAMS_ROOT.exists():
        print(f"No teams folder at {TEAMS_ROOT}")
        return

    print("=== Teams (harness/teams/) ===\n")
    print("Teams are named groups of roles/personas that own work for a Kanban stage.\n")
    print("See stage-map.md next to a domain's kanban.md for which team + workflow is used per column.\n")

    teams = sorted([d for d in TEAMS_ROOT.iterdir() if d.is_dir()])
    for team_dir in teams:
        name = team_dir.name
        defn = team_dir / "definition.md"
        if defn.exists():
            # Grab the first heading or the first non-empty line after the title as a tiny summary
            try:
                lines = defn.read_text(encoding="utf-8").splitlines()
                summary = ""
                for line in lines[1:6]:
                    if line.strip() and not line.startswith("#"):
                        summary = line.strip()[:70]
                        break
                print(f"  {name:25}  {summary}")
            except Exception:
                print(f"  {name}")
        else:
            print(f"  {name}")

    print(f"\nTotal: {len(teams)} teams")
    print("\nReferenced from: context/<domain>-team/mgmt/stage-map.md")
    print("Use with: harem delegate --task '...' --team <name> --workflow <name>")


if __name__ == "__main__":
    main()