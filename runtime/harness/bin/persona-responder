#!/usr/bin/env python3
"""
persona-responder

A lightweight brain for a registry agent that actually replies when addressed.

Run this in the "main" window of an external agent's tmux session after launch-agent:

  ./bin/persona-responder grok-builder --room mexicans

It will:
- Load the exact persona declared for that agent in the registry + the .md file
- Show the persona at startup (same as domain-room-watch does)
- Maintain presence
- React to two kinds of input:
  1. Text typed/steered directly into this pane (stdin) — great for @ from herder-chat
  2. @mentions of itself (or the speaker name) appearing in the room chat.log

When it sees input, it posts a reply back into the room as the proper speaker,
using the loaded persona + mission for context.

This is the missing "the agent actually responds" piece for external persona agents.
V1 uses a clear template reply (so you see the flow working). Plug in a real
LLM caller later (hermes, grok CLI, local model, etc.) in the generate_reply() function.
"""

import argparse
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional

# Make sure we can import the harness agents package
HARNESS_ROOT = Path(__file__).parent.parent
sys.path.insert(0, str(HARNESS_ROOT))

try:
    from agents import registry as agent_registry
except Exception as e:
    print(f"[responder] Could not import registry: {e}", file=sys.stderr)
    sys.exit(1)

ROOMS_ROOT = HARNESS_ROOT / "brain" / "rooms"


def load_persona_text(name: str) -> Optional[str]:
    """Load from the central personas/ folder (big manageable home for all personas,
    including domain-specific ones in subfolders).
    """
    search_roots = [
        HARNESS_ROOT / "personas",                    # primary big folder
        HARNESS_ROOT / "skills" / "planning-team",
        HARNESS_ROOT / "agents" / "personas",
    ]
    variants = [name, name.lower(), name.replace(" ", "_"), name.replace(" ", "-")]

    for root in search_roots:
        if not root.exists():
            continue
        for variant in variants:
            for path in root.rglob(f"*{variant}*.md"):
                if path.is_file():
                    content = path.read_text(encoding="utf-8")
                    return f"# Loaded Persona: {name}\n# Source: {path.relative_to(HARNESS_ROOT)}\n\n{content}"
    return None


def update_presence(presence_dir: Path, speaker: str, persona: str):
    ts = datetime.now(timezone.utc).isoformat()
    (presence_dir / f"{speaker}.last_seen").write_text(ts)
    if persona:
        (presence_dir / f"{speaker}.persona").write_text(persona)


def post_to_room(room: str, speaker: str, message: str):
    cmd = [
        str(HARNESS_ROOT / "bin" / "domain-room"),
        "post",
        room,
        speaker,
        message,
    ]
    try:
        import subprocess
        subprocess.run(cmd, check=False, capture_output=True, timeout=10)
    except Exception as e:
        print(f"[responder] post failed: {e}", file=sys.stderr)


def parse_line_author(line: str) -> Optional[str]:
    """Extract '<speaker>:' author from a room line when present."""
    head, sep, _ = line.partition(":")
    if not sep:
        return None
    author = head.strip().lower()
    return author or None


def should_respond_to_line(line: str, my_names: set[str]) -> bool:
    """Respond only to mentions directed at us, never to our own authored posts."""
    line = line.rstrip("\n")
    if not line or line.startswith("#"):
        return False

    author = parse_line_author(line)
    if author and author in my_names:
        return False

    lower = line.lower()
    return any(f"@{n}" in lower or f" {n}:" in lower for n in my_names if n)


def generate_reply(agent_id: str, display_name: str, persona_name: str, persona_text: str, mission: str, incoming: str, room: str) -> str:
    """
    Generates a reply that gets posted visibly in the room as this agent.
    The requirement is: agents must reply in the chat when addressed.

    This version ensures a visible, in-character post happens.
    For higher quality, replace the generation logic with an actual LLM call
    that has access to the full persona_text + mission + incoming.
    """
    short_persona = (persona_text or f"You are acting as {persona_name}.")[:800]

    # Always produce something that gets posted as the agent in the room
    reply = (
        f"[{display_name}]\n"
        f"{short_persona}\n\n"
        f"Message received: {incoming}\n\n"
        f"As {persona_name}, my current take: [This is where real generation from the persona + skills would go. "
        f"For now the orchestrator (Grok) can provide a high-quality reply if needed.]\n\n"
        f"— {display_name}"
    )
    return reply


def main():
    parser = argparse.ArgumentParser(description="Run a persona-driven responder for a registry agent.")
    parser.add_argument("agent", help="Registry agent id (e.g. grok-builder, swarm-facilitator)")
    parser.add_argument("--room", default="discovery", help="Domain room to participate in")
    parser.add_argument("--speaker", help="Override speaker name (default from registry display_name)")
    parser.add_argument("--poll", type=float, default=3.0, help="Seconds between room polls for @mentions")
    args = parser.parse_args()

    # Resolve agent
    plan = agent_registry.get_launch_plan(args.agent)
    if not plan:
        print(f"[responder] Unknown agent '{args.agent}'. Known: {', '.join(agent_registry.list_agents())}", file=sys.stderr)
        sys.exit(1)

    agent_id = plan["id"]
    display_name = plan.get("display_name") or agent_id
    persona_name = plan.get("persona") or ""
    mission = plan.get("mission") or ""
    speaker = args.speaker or plan.get("room_speaker") or display_name

    room_dir = ROOMS_ROOT / args.room
    chat_log = room_dir / "chat.log"
    presence_dir = room_dir / "presence"
    presence_dir.mkdir(parents=True, exist_ok=True)

    # Load the actual persona definition
    persona_text = load_persona_text(persona_name) if persona_name else None

    print("=" * 70)
    print(f"Persona Responder for: {display_name} ({agent_id})")
    print(f"Persona: {persona_name or '(none)'}")
    print(f"Room: {args.room}")
    print(f"Speaker in room: {speaker}")
    print(f"Mission: {mission}")
    print("=" * 70)

    if persona_text:
        print("\n--- PERSONA LOADED ---\n")
        print(persona_text[:1800] + ("\n... (truncated)" if len(persona_text) > 1800 else ""))
        print("\n" + "=" * 70 + "\n")
    else:
        print(f"[responder] WARNING: No persona file found for '{persona_name}' — using name only.\n")

    print("[responder] Ready. Steer me (@name ...) from herder-chat or type directly here.")
    print("[responder] I will post replies back to the room as the proper speaker.")
    print("[responder] Ctrl-C to stop.\n")

    # Initial presence
    update_presence(presence_dir, speaker, persona_name)

    last_offset = 0
    if chat_log.exists():
        try:
            last_offset = chat_log.stat().st_size
        except Exception:
            pass

    try:
        while True:
            # 1. Check for direct stdin input (what herder-steer / @ typing lands in this pane)
            #    We use a tiny non-blocking trick: select with tiny timeout
            import select
            if select.select([sys.stdin], [], [], 0.1)[0]:
                line = sys.stdin.readline().strip()
                if line:
                    print(f"[stdin] {line}")
                    reply = generate_reply(agent_id, display_name, persona_name, persona_text or "", mission, line, args.room)
                    post_to_room(args.room, speaker, reply)
                    print(f"[posted as {speaker}]")

            # 2. Poll room for fresh @mentions of us (or our speaker name)
            if chat_log.exists():
                try:
                    with open(chat_log, "r", encoding="utf-8", errors="replace") as f:
                        f.seek(last_offset)
                        new_lines = f.readlines()
                        last_offset = f.tell()

                    my_names = {agent_id.lower(), speaker.lower(), display_name.lower()}
                    if persona_name:
                        my_names.add(persona_name.lower())

                    for line in new_lines:
                        line = line.rstrip("\n")
                        if should_respond_to_line(line, my_names):
                            # Very naive: treat the whole line as the incoming stimulus
                            incoming = line
                            print(f"[room mention] {incoming[:120]}...")
                            reply = generate_reply(agent_id, display_name, persona_name, persona_text or "", mission, incoming, args.room)
                            post_to_room(args.room, speaker, reply)
                            print(f"[posted as {speaker}]")

                except Exception as e:
                    print(f"[responder] room poll error: {e}", file=sys.stderr)

            # Heartbeat presence
            update_presence(presence_dir, speaker, persona_name)

            time.sleep(args.poll)

    except KeyboardInterrupt:
        print("\n[responder] Stopped.")
        sys.exit(0)


if __name__ == "__main__":
    main()
