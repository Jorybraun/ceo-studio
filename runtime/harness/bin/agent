#!/usr/bin/env python3
"""
agent — generic, provider-backed agent adapter for the harness swarm.

Run ANY provider's agent (Devin CLI today; others via the provider interface)
as a first-class swarm member that communicates on the domain-room bus, with
two-way (resumable) conversations and enforced cost guardrails.

Examples:
  ./bin/agent dispatch --provider devin --agent devin-research --room discovery \
      --task "Summarize the top Triage item in 2 sentences. Don't edit files."
  ./bin/agent tell --agent devin-research --room discovery \
      --message "The human asks: give one concrete example."
  ./bin/agent dispatch --provider echo --agent tester --room demo --task "hello"   # free, no API
  ./bin/agent sessions --room discovery
  ./bin/agent providers
"""

import argparse
import os
import sys
from pathlib import Path

HARNESS_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HARNESS_ROOT))

from agents import agent_adapter
from agents import providers


def _ensure_a2a_venv():
    """The `serve`/`meeting` commands need the a2a-sdk. If it's not importable
    in the current interpreter, re-exec under the harness venv that has it.
    A guard env var prevents an infinite re-exec loop."""
    try:
        import a2a  # noqa: F401
        return
    except Exception:
        pass
    if os.environ.get("_AGENT_A2A_REEXEC") == "1":
        sys.exit("error: a2a-sdk not available. Install it: "
                 f"{HARNESS_ROOT}/.venv/bin/pip install 'a2a-sdk[http-server]' uvicorn httpx")
    venv_py = HARNESS_ROOT / ".venv" / "bin" / "python"
    if venv_py.exists():
        os.environ["_AGENT_A2A_REEXEC"] = "1"
        os.execv(str(venv_py), [str(venv_py), str(Path(__file__).resolve()), *sys.argv[1:]])
    sys.exit(f"error: a2a-sdk not installed and no venv at {venv_py}. Create it: "
             f"python3 -m venv {HARNESS_ROOT}/.venv && "
             f"{HARNESS_ROOT}/.venv/bin/pip install 'a2a-sdk[http-server]' uvicorn httpx")


def cmd_serve(args):
    _ensure_a2a_venv()
    from agents import a2a_runtime
    caps = [c.strip() for c in (args.capabilities or "").split(",") if c.strip()]
    a2a_runtime.serve(args.agent, provider=args.provider, room=args.room,
                      persona=args.persona, model=args.model, host=args.host,
                      port=args.port, capabilities=caps, timeout=args.timeout, block=True)


def cmd_meeting(args):
    _ensure_a2a_venv()
    import asyncio
    from agents import meeting as meeting_mod
    agenda = args.agenda
    if args.agenda_file:
        agenda = Path(args.agenda_file).read_text(encoding="utf-8")
    if not agenda:
        sys.exit("error: provide --agenda or --agenda-file")
    if args.team:
        members = meeting_mod.members_for_team(args.team)
        if not members:
            sys.exit(f"error: team '{args.team}' not found in agents.json (or empty)")
    else:
        members = meeting_mod.parse_members(args.members or "")
    if not members:
        sys.exit("error: provide --members (e.g. 'ba,architect' from config, or "
                 "'ba:echo:ba,arch:echo:architect') or --team <name>")
    result = asyncio.run(meeting_mod.run_meeting(
        room=args.room, agenda=agenda, members=members, criteria=args.criteria or "",
        orchestrator=args.orchestrator, timeout=args.timeout))
    if not result.get("ok"):
        sys.exit(f"[meeting] failed: {result.get('reason')}")
    print(f"\n[meeting] room={result['room']} "
          f"contributed={result['contributed']} passed={result['passed']}")
    print(f"[meeting] requirements written to {result['requirements_path']}\n")
    print(result["requirements"])


def cmd_room(args):
    # The live room loop drives members through agent_adapter (the same brains
    # the A2A servers wrap), so it needs no a2a-sdk re-exec of its own.
    #
    # Room turns are EPHEMERAL conversational provider calls (run synchronously,
    # one at a time) — they never create a long-lived tmux session. So the
    # "max concurrent tmux agents" proxy must not gate them (otherwise the room
    # goes silent whenever the user happens to have agents mounted). Spend is
    # still fully bounded by the kill switch and per-cycle / hourly spawn caps.
    os.environ.setdefault("CEO_GUARDRAIL_DISABLE_TMUX", "1")
    from agents import room_loop
    from agents import meeting as meeting_mod
    if args.team:
        members = meeting_mod.members_for_team(args.team)
        if not members:
            sys.exit(f"error: team '{args.team}' not found in agents.json (or empty)")
    else:
        members = meeting_mod.parse_members(args.members or "")
    if not members:
        sys.exit("error: provide --members (e.g. 'ba,architect') or --team <name>")
    room_loop.run_room_loop(
        room=args.room, members=members, criteria=args.criteria or "",
        max_followups=args.max_followups, idle_exit=args.idle_exit,
        poll=args.poll, timeout=args.timeout,
        gbrain=args.gbrain, gbrain_limit=args.gbrain_limit,
        gbrain_ceiling=args.gbrain_ceiling)


def cmd_dispatch(args):
    # Provider cost is governed by the shared caps/kill-switch, not a paid-label block.
    r = agent_adapter.dispatch(args.provider, args.agent, args.room, args.task,
                               model=args.model, timeout=args.timeout,
                               interactive=sys.stdin.isatty())
    if not r.get("ok"):
        print(f"[agent] refused/failed: {r.get('reason')}", file=sys.stderr)
        sys.exit(3)
    print(f"[agent] {args.agent} via {r['provider']} in {r.get('seconds')}s (session={r.get('session_id')})")
    print(f"\n--- {args.agent} reply ---\n{r['reply']}\n")


def cmd_tell(args):
    r = agent_adapter.tell(args.agent, args.room, args.message, timeout=args.timeout)
    if not r.get("ok"):
        print(f"[agent] {r.get('reason')}", file=sys.stderr)
        sys.exit(1)
    print(f"\n--- {args.agent} reply ---\n{r['reply']}\n")


def cmd_sessions(args):
    rows = agent_adapter.list_agents(args.room)
    if not rows:
        print(f"(no agents in room '{args.room}')")
        return
    for s in rows:
        print(f"{s.get('agent'):24} provider={s.get('provider'):8} "
              f"model={str(s.get('model')):10} session={s.get('session_id')}")


def cmd_providers(_args):
    print("Available providers:", ", ".join(providers.known_providers()))


def main():
    ap = argparse.ArgumentParser(description="Generic provider-backed swarm agent adapter")
    sub = ap.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("dispatch")
    d.add_argument("--provider", default="devin")
    d.add_argument("--agent", required=True)
    d.add_argument("--room", default="discovery")
    d.add_argument("--task", required=True)
    d.add_argument("--model", default=None)
    d.add_argument("--timeout", type=int, default=600)
    d.set_defaults(func=cmd_dispatch)

    t = sub.add_parser("tell")
    t.add_argument("--agent", required=True)
    t.add_argument("--room", default="discovery")
    t.add_argument("--message", required=True)
    t.add_argument("--timeout", type=int, default=600)
    t.set_defaults(func=cmd_tell)

    s = sub.add_parser("sessions")
    s.add_argument("--room", default="discovery")
    s.set_defaults(func=cmd_sessions)

    p = sub.add_parser("providers")
    p.set_defaults(func=cmd_providers)

    sv = sub.add_parser("serve", help="Run an A2A server that wraps one agent (any provider)")
    sv.add_argument("--agent", required=True)
    sv.add_argument("--provider", default="echo")
    sv.add_argument("--room", default="discovery")
    sv.add_argument("--persona", default=None)
    sv.add_argument("--model", default=None)
    sv.add_argument("--host", default="127.0.0.1")
    sv.add_argument("--port", type=int, default=None)
    sv.add_argument("--capabilities", default="")
    sv.add_argument("--timeout", type=int, default=600)
    sv.set_defaults(func=cmd_serve)

    mt = sub.add_parser("meeting", help="Run an agenda-driven A2A meeting of member agents")
    mt.add_argument("--room", default="discovery")
    mt.add_argument("--agenda", default=None)
    mt.add_argument("--agenda-file", default=None)
    mt.add_argument("--criteria", default="", help="what a good outcome looks like")
    mt.add_argument("--members", default=None,
                    help="comma list of ids (resolved via agents.json) or id[:provider[:persona]]")
    mt.add_argument("--team", default=None, help="named team from agents.json (alternative to --members)")
    mt.add_argument("--orchestrator", default=None,
                    help="optional provider that synthesizes requirements (else deterministic)")
    mt.add_argument("--timeout", type=int, default=600)
    mt.set_defaults(func=cmd_meeting)

    rl = sub.add_parser("room", help="Run a persistent live A2A room: members reply to room messages until stopped")
    rl.add_argument("--room", default="discovery")
    rl.add_argument("--members", default=None,
                    help="comma list of ids (resolved via agents.json) or id[:provider[:persona]]")
    rl.add_argument("--team", default=None, help="named team from agents.json (alternative to --members)")
    rl.add_argument("--criteria", default="", help="what a good outcome looks like (steers relevance)")
    rl.add_argument("--max-followups", dest="max_followups", type=int, default=1,
                    help="bounded agent-to-agent follow-up depth (0 disables A2A back-and-forth)")
    rl.add_argument("--idle-exit", dest="idle_exit", type=int, default=0,
                    help="seconds of inactivity before auto-exit (0 = run until killed)")
    rl.add_argument("--poll", type=float, default=2.0, help="seconds between log polls")
    rl.add_argument("--timeout", type=int, default=600)
    rl.add_argument("--no-gbrain", dest="gbrain", action="store_false",
                    help="disable gbrain shared memory (capture + recall); on by default, auto-skips if gbrain is unhealthy")
    rl.add_argument("--gbrain-limit", dest="gbrain_limit", type=int, default=5,
                    help="max gbrain results recalled per turn")
    rl.add_argument("--gbrain-ceiling", dest="gbrain_ceiling", type=int, default=4000,
                    help="context ceiling: max characters of brain context injected per turn (0 = no cap)")
    rl.set_defaults(func=cmd_room, gbrain=True)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
