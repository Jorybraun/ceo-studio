#!/usr/bin/env python3
"""
harem - The Harem CLI

Unified command for the Harem (your agent swarm).

Usage examples:
  harem kanban-finisher
  harem agent -a my-builder -p architect -d discovery:dev -c
  harem delegate --task "..." --team discovery-planning --workflow discovery-planning-triage
  harem delegate --task "..." --stage Triage                 # resolves via harness/config/kanban.py
  harem --help
"""

import argparse
import os
import subprocess
import sys
from pathlib import Path

HARNESS_ROOT = Path(__file__).resolve().parent.parent

def main():
    parser = argparse.ArgumentParser(
        prog="harem",
        description="The Harem - your personal agent swarm"
    )
    subparsers = parser.add_subparsers(dest="subcommand")

    # kanban-finisher
    p_k = subparsers.add_parser("kanban-finisher", help="Start the long-running Kanban-finishing orchestrator")
    p_k.add_argument("-d", "--domain", default="discovery")
    p_k.add_argument("-r", "--room", default="main")

    # agent creation
    p_a = subparsers.add_parser("agent", help="Start or create an agent with a persona")
    p_a.add_argument("-a", "--agent", required=True, help="Agent name[:model]")
    p_a.add_argument("-p", "--persona", help="Persona to assign")
    p_a.add_argument("-t", "--tag", help="Tag for persistence")
    p_a.add_argument("-d", "--domain", default="discovery:main", help="domain[:room]")
    p_a.add_argument("--headless", action="store_true")
    p_a.add_argument("-c", "--chat", action="store_true", help="Open chat after starting")

    # delegation helper (used by orchestrator) — now driven by the real config object in harness/config/kanban.py
    p_d = subparsers.add_parser("delegate", help="Delegate a Kanban task using the structured config (teams/workflows/stages)")
    p_d.add_argument("--task", required=True)
    p_d.add_argument("--personas", help="Comma-separated personas (legacy/explicit form)")
    p_d.add_argument("--team", help="Named team from harness/teams/")
    p_d.add_argument("--workflow", help="Named workflow from harness/workflows/")
    p_d.add_argument("--stage", help="Kanban stage name — resolved via the real config object in harness/config/kanban.py (recommended)")
    p_d.add_argument("-d", "--domain", default="discovery:main")
    p_d.add_argument("-t", "--tag", default="kanban-auto")

    args = parser.parse_args()

    if args.subcommand == "kanban-finisher":
        launch_kanban_finisher(args.domain, args.room)
    elif args.subcommand == "agent":
        domain, room = args.domain.split(":", 1) if ":" in args.domain else (args.domain, "main")
        launch_agent(args.agent, args.persona, args.tag, domain, room, args.headless, args.chat)
    elif args.subcommand == "delegate":
        domain, room = args.domain.split(":", 1) if ":" in args.domain else (args.domain, "main")
        run_delegate(args.task, args.personas, args.team, args.workflow, args.stage, domain, room, args.tag)
    else:
        parser.print_help()

def launch_kanban_finisher(domain, room):
    print(f"[Harem] Launching Kanban Finisher in {domain}:{room}")
    cmd = [str(HARNESS_ROOT / "bin" / "harem-orchestrator"), "--domain", domain, "--room", room]
    os.execvp(cmd[0], cmd)

def launch_agent(agent_spec, persona, tag, domain, room, headless, open_chat):
    name = agent_spec.split(":")[0]
    print(f"[Harem] Starting agent '{name}' with persona={persona or 'default'} in {domain}:{room}")

    cmd = [str(HARNESS_ROOT / "bin" / "launch-agent"), "--name", name]
    if persona:
        cmd += ["--persona", persona]
    subprocess.run(cmd)

    if not headless:
        resp_cmd = [str(HARNESS_ROOT / "bin" / "persona-responder"), name, "--room", room]
        subprocess.Popen(resp_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"[Harem] Responder started for {name}")

    if open_chat:
        chat_cmd = [str(HARNESS_ROOT / "bin" / "herder-chat"), "--domain", domain]
        os.execvp(chat_cmd[0], chat_cmd)

    print(f"Done. Use @ {name} to direct this agent.")

def run_delegate(task, personas, team, workflow, stage, domain, room, tag):
    print(f"[Harem] Delegating task '{task}' (team={team or 'n/a'}, workflow={workflow or 'n/a'}, stage={stage or 'n/a'})")
    cmd = [
        str(HARNESS_ROOT / "bin" / "harem-delegate"),
        "--task", task,
        "--room", f"{domain}:{room}",
        "--tag", tag,
    ]
    if personas:
        cmd += ["--personas", personas]
    if team:
        cmd += ["--team", team]
    if workflow:
        cmd += ["--workflow", workflow]
    if stage:
        cmd += ["--stage", stage]

    subprocess.run(cmd)
    print("[Harem] Delegation request sent.")

if __name__ == "__main__":
    main()
